# Copier avec npm.cmd run setup:env : les secrets locaux seront générés.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
API_DOCS_ENABLED=true
AUTH_JWT_SECRET=GENERER_UN_SECRET_ALEATOIRE_AVEC_SETUP_ENV
DATABASE_URL=postgresql://suivi_app:CHANGE_ME@127.0.0.1:5433/suivi_dev
DIRECT_DATABASE_URL=postgresql://suivi_migrator:CHANGE_ME@127.0.0.1:5433/suivi_dev
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

# Bootstrap explicite uniquement : fournir ces valeurs dans l'environnement du processus.
# SUIVI_SEED_LOGIN=
# SUIVI_SEED_FIRST_NAME=
# SUIVI_SEED_LAST_NAME=
# SUIVI_SEED_PASSWORD= (ne pas stocker le secret dans ce fichier)
# ALLOW_DEMO_SEED=false
