{
  "name": "@suivi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others-on-fail --names tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-path=dist dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "prisma:validate": "prisma validate",
    "db:check": "node scripts/check-database.mjs",
    "db:local:start": "node scripts/windows-postgres.mjs start",
    "db:local:stop": "node scripts/windows-postgres.mjs stop",
    "db:local:status": "node scripts/windows-postgres.mjs status",
    "api:openapi": "npm run build && node dist/export-openapi.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "npm run build && prisma db seed",
    "db:seed:demo": "npm run build && node prisma/seed-demo.ts",
    "test:database": "node scripts/test-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "auth:bootstrap": "npm run build && node scripts/bootstrap-admin.mjs",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "pretest:database": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@suivi/contracts": "0.1.0",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
