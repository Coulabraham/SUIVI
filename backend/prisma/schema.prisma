generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  ARCHIVED
}

enum ObjectiveStatus {
  PLANNED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CollectionWeekStatus {
  OPEN
  CLOSED
}

enum PaymentStatus {
  VALIDATED
  CANCELLED
}

enum RevisionKind {
  CORRECTION
  CANCELLATION
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SyncOperationType {
  MEMBER_CREATE
  MEMBER_UPDATE
  MEMBER_ARCHIVE
  PAYMENT_CREATE
}

enum SyncOperationStatus {
  PROCESSING
  SYNCED
  CONFLICT
  FAILED
}

enum ChangeType {
  UPSERT
  REMOVE
}

enum NotificationType {
  INFORMATION
  WARNING
  ERROR
  SECURITY
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginIdentifier          String                   @map("login_identifier") @db.VarChar(100)
  loginNormalized          String                   @unique @map("login_normalized") @db.VarChar(100)
  firstName                String                   @map("first_name") @db.VarChar(100)
  lastName                 String                   @map("last_name") @db.VarChar(100)
  phone                    String?                  @db.VarChar(32)
  passwordHash             String                   @map("password_hash") @db.VarChar(255)
  role                     UserRole
  status                   UserStatus               @default(ACTIVE)
  departmentId             String?                  @map("department_id") @db.Uuid
  mustChangePassword       Boolean                  @default(true) @map("must_change_password")
  initialPasswordExpiresAt DateTime?                @map("initial_password_expires_at") @db.Timestamptz(3)
  credentialVersion        Int                      @default(1) @map("credential_version")
  authzVersion             Int                      @default(1) @map("authz_version")
  version                  Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt              DateTime?                @map("last_login_at") @db.Timestamptz(3)
  department               Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  devices                  Device[]
  sessions                 Session[]
  objectives               Objective[]
  periodsCreated           MemberDepartmentPeriod[]
  payments                 Payment[]
  revisions                PaymentRevision[]
  syncOperations           SyncOperation[]
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@index([departmentId, status])
  @@map("users")
}

model Department {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @db.VarChar(120)
  description   String?                  @db.Text
  status        DepartmentStatus         @default(INACTIVE)
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  users         User[]
  members       Member[]
  periods       MemberDepartmentPeriod[]
  payments      Payment[]
  operations    SyncOperation[]
  syncScope     SyncScope?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("departments")
}

model Member {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberNumber String                   @unique @map("member_number") @db.VarChar(80)
  firstName    String                   @map("first_name") @db.VarChar(100)
  lastName     String                   @map("last_name") @db.VarChar(100)
  contact      String?                  @db.VarChar(64)
  neighborhood String?                  @db.VarChar(150)
  departmentId String                   @map("department_id") @db.Uuid
  registeredAt DateTime                 @default(now()) @map("registered_at") @db.Timestamptz(3)
  status       MemberStatus             @default(ACTIVE)
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  department   Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  periods      MemberDepartmentPeriod[]
  payments     Payment[]

  @@index([departmentId, status, lastName, firstName, id])
  @@map("members")
}

model MemberDepartmentPeriod {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String     @map("member_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  startsAt     DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?  @map("ends_at") @db.Timestamptz(3)
  createdById  String     @map("created_by_id") @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments     Payment[]

  @@unique([id, memberId, departmentId])
  @@index([memberId, startsAt])
  @@index([departmentId, endsAt])
  @@index([createdById])
  @@map("member_department_periods")
}

model Objective {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String           @db.VarChar(160)
  targetAmount BigInt           @map("target_amount")
  startsOn     DateTime         @map("starts_on") @db.Date
  endsOn       DateTime         @map("ends_on") @db.Date
  timezone     String           @db.VarChar(80)
  status       ObjectiveStatus  @default(PLANNED)
  createdById  String           @map("created_by_id") @db.Uuid
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt     DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  weeks        CollectionWeek[]
  payments     Payment[]

  @@index([createdById])
  @@map("objectives")
}

model CollectionWeek {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId  String               @map("objective_id") @db.Uuid
  number       Int
  startsOn     DateTime             @map("starts_on") @db.Date
  endsOn       DateTime             @map("ends_on") @db.Date
  collectionOn DateTime?            @map("collection_on") @db.Date
  status       CollectionWeekStatus @default(OPEN)
  objective    Objective            @relation(fields: [objectiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments     Payment[]

  @@unique([id, objectiveId])
  @@unique([objectiveId, number])
  @@map("collection_weeks")
}

model Payment {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId            String                 @map("member_id") @db.Uuid
  departmentId        String                 @map("department_id") @db.Uuid
  affiliationId       String                 @map("affiliation_id") @db.Uuid
  collectedById       String                 @map("collected_by_id") @db.Uuid
  objectiveId         String                 @map("objective_id") @db.Uuid
  collectionWeekId    String                 @map("collection_week_id") @db.Uuid
  originalAmount      BigInt                 @map("original_amount")
  method              String                 @db.VarChar(40)
  reference           String?                @db.VarChar(120)
  collectedAt         DateTime               @map("collected_at") @db.Timestamptz(3)
  receivedAt          DateTime               @default(now()) @map("received_at") @db.Timestamptz(3)
  status              PaymentStatus          @default(VALIDATED)
  version             Int                    @default(1)
  idempotencyKey      String                 @unique @map("idempotency_key") @db.Uuid
  originDeviceId      String                 @map("origin_device_id") @db.Uuid
  memberLabelSnapshot String                 @map("member_label_snapshot") @db.VarChar(220)
  member              Member                 @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department          Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  affiliation         MemberDepartmentPeriod @relation(fields: [affiliationId, memberId, departmentId], references: [id, memberId, departmentId], onDelete: Restrict, onUpdate: Restrict)
  collectedBy         User                   @relation(fields: [collectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  objective           Objective              @relation(fields: [objectiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectionWeek      CollectionWeek         @relation(fields: [collectionWeekId, objectiveId], references: [id, objectiveId], onDelete: Restrict, onUpdate: Restrict)
  originDevice        Device                 @relation(fields: [originDeviceId, collectedById], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  revisions           PaymentRevision[]      @relation("PaymentRevisions")
  replacements        PaymentRevision[]      @relation("ReplacementPayment")
  adjustments         PaymentAdjustment[]

  @@index([departmentId, objectiveId, collectedAt, id])
  @@index([memberId, collectedAt, id])
  @@index([collectionWeekId, status])
  @@index([affiliationId, memberId, departmentId])
  @@index([collectedById])
  @@index([collectionWeekId, objectiveId])
  @@index([objectiveId])
  @@index([originDeviceId, collectedById])
  @@map("payments")
}

model PaymentRevision {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId            String             @map("payment_id") @db.Uuid
  revisionNumber       Int                @map("revision_number")
  actorId              String             @map("actor_id") @db.Uuid
  deviceId             String?            @map("device_id") @db.Uuid
  reason               String             @db.Text
  kind                 RevisionKind
  previousAmount       BigInt             @map("previous_amount")
  newAmount            BigInt             @map("new_amount")
  previousMethod       String             @map("previous_method") @db.VarChar(40)
  newMethod            String             @map("new_method") @db.VarChar(40)
  beforeValue          Json               @map("before_value")
  afterValue           Json               @map("after_value")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  replacementPaymentId String?            @map("replacement_payment_id") @db.Uuid
  payment              Payment            @relation("PaymentRevisions", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor                User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device               Device?            @relation(fields: [deviceId, actorId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  replacementPayment   Payment?           @relation("ReplacementPayment", fields: [replacementPaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adjustment           PaymentAdjustment?

  @@unique([id, paymentId])
  @@unique([paymentId, revisionNumber])
  @@index([actorId])
  @@index([deviceId, actorId])
  @@index([replacementPaymentId])
  @@map("payment_revisions")
}

model PaymentAdjustment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  revisionId  String          @unique @map("revision_id") @db.Uuid
  deltaAmount BigInt          @map("delta_amount")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision    PaymentRevision @relation(fields: [revisionId, paymentId], references: [id, paymentId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, paymentId])
  @@index([paymentId])
  @@map("payment_adjustments")
}

model Device {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  label        String            @db.VarChar(120)
  status       DeviceStatus      @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  lastSyncedAt DateTime?         @map("last_synced_at") @db.Timestamptz(3)
  revokedAt    DateTime?         @map("revoked_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions     Session[]
  payments     Payment[]
  revisions    PaymentRevision[]
  operations   SyncOperation[]
  auditLogs    AuditLog[]

  @@unique([id, userId])
  @@index([userId])
  @@map("devices")
}

model Session {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  deviceId          String         @map("device_id") @db.Uuid
  credentialVersion Int            @map("credential_version")
  authzVersion      Int            @map("authz_version")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device            Device         @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([deviceId, userId])
  @@map("sessions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionId, consumedAt])
  @@map("refresh_tokens")
}

model SyncOperation {
  id              String              @id @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  departmentId    String              @map("department_id") @db.Uuid
  deviceId        String              @map("device_id") @db.Uuid
  type            SyncOperationType
  entityId        String              @map("entity_id") @db.Uuid
  baseVersion     Int?                @map("base_version")
  contractVersion Int                 @default(1) @map("contract_version")
  scopeGeneration Int                 @map("scope_generation")
  authzVersion    Int                 @map("authz_version")
  payload         Json
  requestHash     String              @map("request_hash") @db.Char(64)
  status          SyncOperationStatus @default(PROCESSING)
  resultCode      String?             @map("result_code") @db.VarChar(80)
  resultData      Json?               @map("result_data")
  createdAtClient DateTime            @map("created_at_client") @db.Timestamptz(3)
  receivedAt      DateTime            @default(now()) @map("received_at") @db.Timestamptz(3)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(3)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device          Device              @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, deviceId, receivedAt])
  @@index([departmentId, status])
  @@index([deviceId, userId])
  @@map("sync_operations")
}

model SyncScope {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                  String       @unique @db.VarChar(80)
  departmentId         String?      @unique @map("department_id") @db.Uuid
  sequence             BigInt       @default(0)
  generation           Int          @default(1)
  minAvailableSequence BigInt       @default(0) @map("min_available_sequence")
  department           Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changes              SyncChange[]

  @@map("sync_scopes")
}

model SyncChange {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeId       String     @map("scope_id") @db.Uuid
  sequence      BigInt
  entityType    String     @map("entity_type") @db.VarChar(60)
  entityId      String     @map("entity_id") @db.Uuid
  changeType    ChangeType @map("change_type")
  entityVersion Int        @map("entity_version")
  projection    Json
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  scope         SyncScope  @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeId, sequence])
  @@map("sync_changes")
}

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId  String           @map("recipient_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  eventKey     String           @map("event_key") @db.VarChar(160)
  type         NotificationType
  title        String           @db.VarChar(160)
  message      String           @db.Text
  entityType   String?          @map("entity_type") @db.VarChar(60)
  entityId     String?          @map("entity_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  recipient    User             @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipientId, eventKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_feed_idx")
  @@index([departmentId])
  @@map("notifications")
}

model AuditLog {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?      @map("actor_id") @db.Uuid
  actorRole    UserRole?    @map("actor_role")
  departmentId String?      @map("department_id") @db.Uuid
  action       String       @db.VarChar(80)
  entityType   String       @map("entity_type") @db.VarChar(60)
  entityId     String?      @map("entity_id") @db.Uuid
  beforeValue  Json?        @map("before_value")
  afterValue   Json?        @map("after_value")
  occurredAt   DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  outcome      AuditOutcome
  deviceId     String?      @map("device_id") @db.Uuid
  requestId    String       @map("request_id") @db.Uuid
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([departmentId, occurredAt, id])
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_logs_timeline_idx")
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([deviceId])
  @@map("audit_logs")
}
