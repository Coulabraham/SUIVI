{
  "name": "suivi",
  "version": "0.1.0",
  "private": true,
  "description": "SUIVI — gestion des encaissements hebdomadaires",
  "workspaces": [
    "frontend",
    "backend",
    "packages/contracts"
  ],
  "engines": {
    "node": "26.13.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "npm run build --workspace @suivi/contracts && concurrently --kill-others-on-fail --names api,web \"npm run dev --workspace @suivi/backend\" \"npm run dev --workspace @suivi/frontend\"",
    "build": "npm run build --workspace @suivi/contracts && npm run build --workspace @suivi/backend && npm run build --workspace @suivi/frontend",
    "typecheck": "npm run build --workspace @suivi/contracts && tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @suivi/contracts && npm run test --workspaces --if-present",
    "test:e2e": "npm run build && node backend/scripts/test-database.mjs --e2e",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "db:local:start": "npm run db:local:start --workspace @suivi/backend",
    "db:local:stop": "npm run db:local:stop --workspace @suivi/backend",
    "db:local:status": "npm run db:local:status --workspace @suivi/backend",
    "db:check": "npm run db:check --workspace @suivi/backend",
    "prisma:validate": "npm run prisma:validate --workspace @suivi/backend",
    "api:openapi": "npm run build --workspace @suivi/contracts && npm run api:openapi --workspace @suivi/backend",
    "prisma:generate": "npm run prisma:generate --workspace @suivi/backend",
    "db:migrate": "npm run db:migrate --workspace @suivi/backend",
    "db:status": "npm run db:status --workspace @suivi/backend",
    "db:seed": "npm run db:seed --workspace @suivi/backend",
    "db:seed:demo": "npm run db:seed:demo --workspace @suivi/backend",
    "test:database": "npm run test:database --workspace @suivi/backend",
    "db:backup": "npm run db:backup --workspace @suivi/backend",
    "auth:bootstrap": "npm run auth:bootstrap --workspace @suivi/backend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "argon2@0.45.2": true
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
